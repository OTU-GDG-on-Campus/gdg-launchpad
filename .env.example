# Copy to .env.local and fill in. Only VITE_-prefixed vars reach the browser, so never put a
# secret behind that prefix. Server-only values belong in Vercel project environment variables.

# Supabase project, from Project Settings > API Keys. The anon key is public by design and is
# safe in the browser only because row-level security policies are enforced on every table.
VITE_SUPABASE_URL=https://eavnzbmsfpslwdgpjfjv.supabase.co
VITE_SUPABASE_ANON_KEY=

# Google OAuth client ID from Google Cloud Console. Public value.
VITE_GOOGLE_CLIENT_ID=

# Server-only. Never prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY=

# Read by supabase/config.toml for the local stack only. Export these before `npm run db:start`.
# The hosted project reads its Google credentials from the dashboard, not from here.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
