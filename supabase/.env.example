# Copy to supabase/.env (git-ignored) to send real sign-in emails through Brevo from the local stack.
# Also set enabled = true under [auth.email.smtp] in supabase/config.toml, then restart the stack.
# The login is the one on Brevo's SMTP & API page, not the account email. Never commit real values.
BREVO_SMTP_USER=
BREVO_SMTP_KEY=
